# 複製為 .env 後在本機填寫。正式部署請在 Streamlit Secrets 設定。
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1200
CARBONLENS_MAX_CLAIM_CHARS=6000
CARBONLENS_USER_DAILY_CALLS=10
CARBONLENS_GLOBAL_DAILY_CALLS=100
# true 代表公開展示，CSV 上傳與付費分析需要登入。
CARBONLENS_PUBLIC=true
# 使用者名稱對應 SHA256 存取碼摘要的 JSON。可使用 scripts/access_code.py 產生。
CARBONLENS_USERS_JSON={}
# 本機預設 SQLite。Supabase 可設定 postgresql+psycopg://... 並使用 sslmode=require。
DATABASE_URL=
